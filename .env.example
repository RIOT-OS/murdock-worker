# change this:
MURDOCK_HOSTNAME=unnamed-worker

# select target environment
## default: ci-staging
MURDOCK_SSH_HOST=ci-staging

## ci-prod
#MURDOCK_SSH_HOST=ci-prod

## *current production settings*
# note: three lines
#MURDOCK_SSH_HOST=ci-old
#MURDOCK_REMOTE_DISQUE_HOST_PORT=localhost:7711
#MURDOCK_REMOTE_REDIS_HOST_PORT=localhost:6379

# set this to "default-first default" to work on production jobs.
MURDOCK_QUEUES="default-first default"

# By default, this compose file will deploy only one murdock worker, 
# which calls make with #"-j ${MURDOCK_JOBS}".
#
# If you have the RAM and CPU resources, scale up to about one worker per
# physical core, using
# `docker-compose up -d --scale worker=N`.
#
# If that would exhaust physical RAM, scale less but use a higher `MURDOCK_JOBS`
# number.
MURDOCK_JOBS=4

# This specifies the size of the tmpfs that murdock will build on, *per worker*.
# currently, keep this >=2g.
MURDOCK_BUILD_TMPFS_GIGS=2

# This currently (October 2026) needs to be >=16GB to be useful.
# Lower values will still work, but significantly reduce the cache hit rate.
# Higher number of workers require more cache.
# A machine with 32 workers currently requires 64GB of cache to have a hit rate
# of 80-90%.
MURDOCK_CCACHE_MAXSIZE_GIGS=16

# configure watchtower poll interval (in seconds)
WATCHTOWER_POLL_INTERVAL=60
